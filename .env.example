# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Sanity CMS Configuration (Optional - fallback editorial content is provided if not set)
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"

# USA Landing Page Integrations (Optional - configure real URLs/keys before enabling)
VITE_CALENDLY_USA_URL=""
VITE_US_LEAD_ENDPOINT="/api/us-lead"

# Cloudflare Pages Functions Lead Delivery (Optional server-side variables)
# US_LEAD_WEBHOOK_URL=""
# RESEND_API_KEY=""
