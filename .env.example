# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Sanity CMS Configuration (Optional - fallback editorial content is provided if not set)
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"

# USA Landing Page Integrations
# Public Calendly URL (must start with https:// - set in Cloudflare Pages Build & Production env vars)
VITE_CALENDLY_USA_URL=""
VITE_US_LEAD_ENDPOINT="/api/us-lead"

# Cloudflare Pages Functions Server-Side Secrets (NEVER prefix with VITE_)
# Option 1: Official Meta WhatsApp Business Cloud API (preferred direct WhatsApp delivery)
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TO_NUMBER="5519989332087"
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG="en_US"

# Option 2: Automatic Email Relay via Resend
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Auditoria SEO <onboarding@resend.dev>"
# US_LEAD_TO_EMAIL="comercial@auditoriaseo.com.br"

# Option 3: HTTPS Automation Webhook (Make / Zapier / n8n / CRM)
# US_LEAD_WEBHOOK_URL=""
# US_LEAD_WEBHOOK_SECRET=""

