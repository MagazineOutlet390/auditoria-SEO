# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Sanity CMS Configuration (Optional - fallback editorial content is provided if not set)
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"

# USA Landing Page Integrations
# Public Calendly URL (must start with https:// - set in Cloudflare Pages Build & Production env vars)
VITE_CALENDLY_USA_URL=""
# FormSubmit AJAX recipient: set your Gmail for initial activation, then replace with FormSubmit's random alias token
VITE_FORMSUBMIT_USA_TARGET=""

